# Cloudflare Workers static assets read this file; it is not served.
# Vite fingerprints everything under /assets/ (the hash changes when the file does), so browsers may keep it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and the share image keep their names, so they are cached for a day.
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
